{
  "name": "@faqchatbot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "corepack pnpm build && node dist/db/migrate.js",
    "db:seed": "corepack pnpm build && node dist/db/seed.js",
    "dev": "node --watch dist/main.js",
    "predev": "corepack pnpm build",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.2.0",
    "@faqchatbot/config": "workspace:*",
    "@faqchatbot/contracts": "workspace:*",
    "@faqchatbot/logger": "workspace:*",
    "@nestjs/jwt": "^11.0.0",
    "argon2": "^0.45.1",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-fastify": "^11.1.5",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "ioredis": "^5.9.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^3.2.4"
  }
}
